# Create a key at https://spatial9.ai/connect. Never commit the real .env file.
SPATIAL9_API_KEY=s9_replace_me

# Long random string. Spatial9 sends it back in X-A2A-Notification-Token on every push.
A2A_WEBHOOK_TOKEN=replace_with_a_long_random_string

# Public https address of the webhook service (for example through a tunnel or reverse proxy).
PUBLIC_WEBHOOK_URL=https://your-domain.example/a2a/webhook

MINIO_ROOT_USER=spatial9
MINIO_ROOT_PASSWORD=replace_me_too
POSTGRES_PASSWORD=replace_me_as_well
DATABASE_URL=postgresql://spatial9:replace_me_as_well@postgres:5432/spatial9
KAFKA_BROKERS=kafka:9092
VALKEY_URL=redis://valkey:6379/0
MINIO_ENDPOINT=minio:9000
